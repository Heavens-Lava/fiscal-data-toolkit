{
  "name": "fiscal-data-toolkit",
  "version": "1.0.0",
  "description": "One-command scripts that pull live US fiscal, banking, money-supply, and company-financials data from official government APIs (no API keys required).",
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "fiscal": "node scripts/fiscal-snapshot.mjs",
    "banks": "node scripts/banking-snapshot.mjs",
    "money": "node scripts/money-supply.mjs",
    "money-debt": "node scripts/money-debt-cash.mjs",
    "stock": "node scripts/stock-fundamentals.mjs",
    "screen": "node scripts/revenue-growth.mjs",
    "trade": "node scripts/trade-balance.mjs",
    "spending": "node scripts/spending-by-category.mjs",
    "tax-detail": "node scripts/tax-dollar-detail.mjs",
    "household": "node scripts/household-debt.mjs",
    "holders": "node scripts/household-debt-holders.mjs",
    "dashboard": "node scripts/dashboard.mjs",
    "digest": "node scripts/weekly-digest.mjs",
    "monthly": "node scripts/monthly-briefs.mjs",
    "social:index": "node scripts/social-index.mjs",
    "calendar": "node scripts/monthly-content-calendar.mjs",
    "cost": "node scripts/cost-of-living-index.mjs",
    "az": "node scripts/arizona-economy.mjs",
    "budget-household": "node scripts/budget-vs-household.mjs",
    "markets": "node scripts/market-watch.mjs",
    "market-structure": "node scripts/market-structure-watch.mjs",
    "world": "node scripts/world-country-snapshot.mjs",
    "weather": "node scripts/weather-check.mjs",
    "earthquakes": "node scripts/earthquake-watch.mjs",
    "crypto": "node scripts/crypto-market-watch.mjs",
    "space": "node scripts/nasa-space-watch.mjs",
    "osm": "node scripts/osm-place-profile.mjs",
    "marriage": "node scripts/marriage-rates.mjs",
    "census:housing": "node scripts/census-population-housing.mjs",
    "census": "node scripts/census-topic-snapshot.mjs",
    "wages": "node scripts/occupation-wages.mjs",
    "web": "node server.mjs"
  },
  "license": "MIT",
  "private": true
}
